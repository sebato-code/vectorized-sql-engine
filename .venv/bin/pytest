#!/bin/sh
REPO_ROOT="$(cd "$(dirname "$0")/../.." && pwd)"
export PYTHONPATH="${REPO_ROOT}:${PYTHONPATH}"
cd "${REPO_ROOT}"
if command -v pytest >/dev/null 2>&1; then
    exec pytest -c "${REPO_ROOT}/pyproject.toml" "$@"
elif [ -x /usr/bin/pytest ]; then
    exec /usr/bin/pytest -c "${REPO_ROOT}/pyproject.toml" "$@"
elif command -v python3 >/dev/null 2>&1; then
    exec python3 -m pytest -c "${REPO_ROOT}/pyproject.toml" "$@"
elif command -v python >/dev/null 2>&1; then
    exec python -m pytest -c "${REPO_ROOT}/pyproject.toml" "$@"
else
    echo "pytest not found" >&2
    exit 1
fi
