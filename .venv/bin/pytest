#!/bin/sh
SCRIPT_DIR="$(dirname "$0")"
REPO_ROOT="$(cd "${SCRIPT_DIR}/../.." && pwd)"
VENDOR_DIR="${SCRIPT_DIR}/../vendor"

# Prepend repo root, vendor fallback, and existing PYTHONPATH
export PYTHONPATH="${REPO_ROOT}:${VENDOR_DIR}:${PYTHONPATH}"

# Add any system site-packages or dist-packages if present
for sp in /usr/lib/python*/site-packages /usr/lib/python*/dist-packages /usr/lib/python3/dist-packages /usr/local/lib/python*/site-packages /usr/local/lib/python*/dist-packages /root/.local/lib/python*/site-packages /home/*/.local/lib/python*/site-packages; do
    if [ -d "$sp" ]; then
        export PYTHONPATH="${sp}:${PYTHONPATH}"
    fi
done

# Try native pytest binary if available and functional
if [ -x /usr/bin/pytest ] && /usr/bin/pytest --version >/dev/null 2>&1; then
    exec /usr/bin/pytest "$@"
fi

# Prefer python binary that already has pytest installed
PY=""
for cand in /usr/bin/python3 python3 /usr/local/bin/python3 python; do
    if command -v "$cand" >/dev/null 2>&1; then
        full="$(command -v "$cand")"
        if "$full" -c "import pytest" >/dev/null 2>&1; then
            PY="$full"
            break
        fi
    fi
done

# If no candidate currently has pytest, select best available python and attempt pip install
if [ -z "$PY" ]; then
    if command -v python3 >/dev/null 2>&1; then
        PY="$(command -v python3)"
    elif [ -x /usr/local/bin/python3 ]; then
        PY="/usr/local/bin/python3"
    elif [ -x /usr/bin/python3 ]; then
        PY="/usr/bin/python3"
    elif command -v python >/dev/null 2>&1; then
        PY="$(command -v python)"
    else
        echo "No python interpreter found" >&2
        exit 1
    fi

    # Attempt to install pytest via pip if not already importable
    if ! "$PY" -c "import pytest" >/dev/null 2>&1; then
        "$PY" -m pip install -q pytest >/dev/null 2>&1 || pip install -q pytest >/dev/null 2>&1 || pip3 install -q pytest >/dev/null 2>&1 || true
    fi
fi

# Run pytest through python module
exec "$PY" -m pytest "$@"
